{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],

  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/scan",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/scan",
      "schedule": "0 10 * * *"
    }
  ]
}
