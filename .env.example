# API & System Settings
APP_NAME="Risk News Scanner & Reporter"
DEBUG=True
PORT=8000

# Gemini AI API Key (Lấy tại https://aistudio.google.com/)
GEMINI_API_KEY=""

# Email SMTP Settings (Dùng để gửi cảnh báo email)
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SENDER_EMAIL="your-email@gmail.com"
SENDER_NAME="Hệ Thống Cảnh Báo Rủi Ro Doanh Nghiệp"

# Database
DATABASE_URL="sqlite:///./risk_scanner.db"
